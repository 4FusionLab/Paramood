{
  "name": "paramood-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "cd .. && eslint frontend/src src tests/intellisense.test.mjs eslint.config.js frontend/vite.config.ts",
    "format:check": "prettier --check --ignore-path ../.prettierignore \"src/**/*.{ts,tsx,css}\" \"../src/**/*.ts\" \"../tests/*.mjs\" \"*.{js,ts,json,html}\" \"../*.{js,json,yml}\" \"../.github/workflows/*.yml\" \"../Paramood/*.manifest\"",
    "format": "prettier --write --ignore-path ../.prettierignore \"src/**/*.{ts,tsx,css}\" \"../src/**/*.ts\" \"../tests/*.mjs\" \"*.{js,ts,json,html}\" \"../*.{js,json,yml}\" \"../.github/workflows/*.yml\" \"../Paramood/*.manifest\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "lucide-preact": "^0.468.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@preact/preset-vite": "^2.10.0",
    "eslint": "^9.20.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
